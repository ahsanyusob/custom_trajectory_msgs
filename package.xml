<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>custom_trajectory_msgs</name>
  <version>0.0.0</version>
  <description>Extended package for the official robot trajectory message definitions, https://github.com/ros2/common_interfaces/tree/rolling/trajectory_msgs</description>

  <maintainer email="ahsanyusob@gmail.com">Ahsan Yusob</maintainer>

  <license>Apache License 2.0</license>

  <author email="ahsanyusob@gmail.com">Ahsan Yusob</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
